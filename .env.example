DEBUG=1
# Üretimde DEBUG=0 yapın ve SECRET_KEY için güçlü bir anahtar üretin:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DEBUG=0 iken SECRET_KEY zorunludur; uygulama aksi halde başlamaz.
SECRET_KEY=yerel-gelistirme-icin-degistirin
ALLOWED_HOSTS=localhost,127.0.0.1
# Coolify/HTTPS dağıtımında alan adını buraya ve ALLOWED_HOSTS'e ekle (şema dahil):
# CSRF_TRUSTED_ORIGINS=https://akaryakit.ornek.gov.tr
CSRF_TRUSTED_ORIGINS=
# Üretimde ters proxy HTTPS sonlandırıyorsa SECURE_SSL_REDIRECT=0 bırakın,
# doğrudan HTTPS servis ediliyorsa 1 yapın.
SECURE_SSL_REDIRECT=0
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=akaryakit
POSTGRES_USER=akaryakit
POSTGRES_PASSWORD=yerel-gelistirme-parolasini-degistirin
POSTGRES_HOST=db
POSTGRES_PORT=5432
WEB_PORT=8000
DB_EXPOSE_PORT=5433

